# JUNO's hook service as a systemd user service of juno-runner (plan Increment 6, D-180, D-196).
# Install: as juno-runner, copy to ~/.config/systemd/user/juno-hook.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now juno-hook.service
# It runs as juno-runner (never root, never juno-agent). It refuses to start, and says why in
# `journalctl --user -u juno-hook.service`, whenever the shared start-up check refuses (D-194).
# It anchors its journal with /usr/bin/git, at most a minute apart and once more when it stops (§3.4.1, D-198), to the
# repository pinned in root's own /etc/juno/anchors.json, over SSH with the host key and the deploy key that file names
# (D-208; docs/operator-setup.md, Part D). --anchors is only JUNO's own copy, rebuilt from the repository at every start.
[Unit]
Description=JUNO hook service (governs Claude Code's tool calls)
# Rootless Docker answers the runtime check (D-131); start after it.
After=docker.service

[Service]
Type=simple
# A user service does not read ~/.bashrc: name rootless Docker's socket (%t is /run/user/<uid>) and node's folder here.
Environment=DOCKER_HOST=unix://%t/docker.sock
Environment=PATH=/opt/node22/bin:/usr/bin:/bin
ExecStart=/opt/node22/bin/node /opt/juno/dist/runner/src/juno.js hook serve --socket /var/lib/juno-hook/hook.sock --control /var/lib/juno-runner/admit.sock --journal /var/lib/juno-runner/journal --anchor /etc/juno/operator.pub --journal-key /var/lib/juno-runner/journal-key --anchors /var/lib/juno-runner/juno-anchors --anchor-pin /etc/juno/anchors.json --anchor-interval 60 --git /usr/bin/git --workspace /srv/juno-work --checkpoints /var/lib/juno-runner/checkpoints --protect /etc/claude-code --protect /home/juno-agent
Restart=no
UMask=0077

[Install]
WantedBy=default.target
